{
  "title": "Umbrella Collector",
  "uid": "umbrella-collector",
  "timezone": "browser",
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "PPS / EPS",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(umbrella_ingest_packets_received_total[1m])",
          "legendFormat": "packets received/s (PPS)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(umbrella_storage_events_written_total[1m])",
          "legendFormat": "events written/s (EPS)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Storage write latency (p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(umbrella_storage_write_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(umbrella_storage_write_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Queue sizes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "umbrella_ingest_out_queue_length",
          "legendFormat": "out (raw packets)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "umbrella_pipeline_results_queue_length",
          "legendFormat": "results (parsed)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Drops / errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(umbrella_ingest_packets_dropped_total[1m])",
          "legendFormat": "dropped/s (queue full)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(umbrella_ingest_packets_truncated_total[1m])",
          "legendFormat": "truncated/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(umbrella_pipeline_packets_invalid_total[1m])",
          "legendFormat": "parse errors/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(umbrella_storage_write_errors_total[1m])",
          "legendFormat": "storage write errors/s"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
