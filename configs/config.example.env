# Copy to .env for local development, or to /etc/umbrella/collector.env for
# the systemd unit (deploy/systemd/umbrella-collector.service), and adjust.

UMBRELLA_LISTEN_ADDR=:2055
UMBRELLA_HTTP_ADDR=:8080
UMBRELLA_LOG_LEVEL=info
# Локально: `make clickhouse-up` (см. deploy/docker/docker-compose.yml),
# затем раскомментировать:
# UMBRELLA_CLICKHOUSE_DSN=clickhouse://umbrella:umbrella@localhost:9000/umbrella
UMBRELLA_CLICKHOUSE_DSN=
UMBRELLA_KAFKA_BROKERS=
UMBRELLA_SHUTDOWN_TIMEOUT=10s
